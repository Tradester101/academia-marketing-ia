---
// Landing page sections below the hero (used only by src/content/docs/index.mdx).
const stats = [
  { value: '10', label: 'módulos prácticos' },
  { value: '3', label: 'niveles, de básico a avanzado' },
  { value: '3', label: 'plantillas para clientes' },
  { value: 'IA', label: 'tutor integrado en tu panel' },
];

const pillars = [
  {
    title: 'Aprende haciendo',
    text: 'Cada módulo cierra con un entregable real: una landing, un calendario editorial, un tablero o una app con IA.',
    icon: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  },
  {
    title: 'IA aplicada al negocio',
    text: 'Prompts reutilizables, contenido multimedia, agentes y automatizaciones no-code para producir más con menos.',
    icon: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="3.5"/>',
  },
  {
    title: 'Listo para vender',
    text: 'Paquetes de servicios, brief de cliente, checklist de lanzamiento y librería de prompts para trabajar con clientes.',
    icon: '<path d="M3 7h18v13H3z"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/>',
  },
  {
    title: 'Tu progreso, guardado',
    text: 'Crea tu cuenta, marca cada módulo al terminarlo y retoma justo donde lo dejaste desde tu panel.',
    icon: '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 6-6"/>',
  },
];

const levels = [
  {
    tag: 'Nivel 1 · Básico',
    range: 'Módulos 01–03',
    title: 'Fundamentos y estrategia',
    items: ['Buyer persona y propuesta de valor', 'Community management profesional', 'Prompt engineering aplicado'],
    href: '/basico/modulo-01-fundamentos/',
  },
  {
    tag: 'Nivel 2 · Intermedio',
    range: 'Módulos 04–07',
    title: 'Captación y automatización',
    items: ['SEO técnico y copywriting', 'Paid media, GA4 y GTM', 'IA multimedia y flujos no-code'],
    href: '/intermedio/resumen/',
  },
  {
    tag: 'Nivel 3 · Avanzado',
    range: 'Módulos 08–10',
    title: 'Growth e IA a medida',
    items: ['Experimentación y CRO', 'Apps y agentes de IA en Vercel', 'DevOps con GitHub Actions'],
    href: '/avanzado/resumen/',
  },
];

const builds = [
  ['01', 'Buyer persona y propuesta de valor de tu marca'],
  ['02', 'Calendario editorial de 30 días'],
  ['03', 'Landing page publicada en Vercel'],
  ['04', 'SEO on-page, Search Console y secuencia de email'],
  ['05', 'GTM, GA4, enlaces UTM y tablero en Data Studio'],
  ['06', 'Matriz de crisis y flujo de aprobación de contenido'],
  ['07', 'Sistema de captación completo para un cliente piloto'],
  ['08', 'Backlog de 10 hipótesis ICE y modelo LTV/CAC'],
  ['09', 'Herramienta con IA en Next.js + Vercel AI SDK'],
  ['10', 'Proyecto final en producción con automatización de leads'],
];
---

<div class="am-landing not-content">
  <ul class="am-stats" aria-label="El programa en cifras">
    {stats.map(s => (
      <li><strong>{s.value}</strong><span>{s.label}</span></li>
    ))}
  </ul>

  <section class="am-section" aria-labelledby="am-why">
    <p class="am-eyebrow">Por qué esta academia</p>
    <h2 id="am-why">Menos teoría suelta. <span class="am-grad">Más resultados que puedes enseñar.</span></h2>
    <div class="am-pillars">
      {pillars.map(p => (
        <article class="am-card">
          <span class="am-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} /></span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="am-section" aria-labelledby="am-route">
    <p class="am-eyebrow">Ruta formativa</p>
    <h2 id="am-route">Tres niveles, <span class="am-grad">un camino claro.</span></h2>
    <ol class="am-levels">
      {levels.map((l, i) => (
        <li>
          <a class="am-level" href={l.href}>
            <span class="am-level-node" aria-hidden="true">{i + 1}</span>
            <span class="am-level-tag">{l.tag} · {l.range}</span>
            <h3>{l.title}</h3>
            <ul>{l.items.map(item => <li>{item}</li>)}</ul>
            <span class="am-level-link">Ver nivel <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="am-section" aria-labelledby="am-build">
    <p class="am-eyebrow">Lo que vas a construir</p>
    <h2 id="am-build">Un portafolio de <span class="am-grad">entregables reales.</span></h2>
    <ol class="am-builds">
      {builds.map(([n, text]) => (
        <li><span>{n}</span>{text}</li>
      ))}
    </ol>
  </section>

  <section class="am-cta" aria-labelledby="am-cta-title">
    <div class="am-cta-glow" aria-hidden="true" />
    <h2 id="am-cta-title">Tu primer módulo te espera.</h2>
    <p>Empieza hoy con los fundamentos y guarda tu avance en tu panel personal.</p>
    <div class="am-cta-actions">
      <a class="am-btn am-btn-primary" href="/basico/modulo-01-fundamentos/">Empezar ahora</a>
      <a class="am-btn am-btn-ghost" href="/servicios/">Servicios y mentoría</a>
    </div>
  </section>
</div>

<style>
  .am-landing { display: grid; gap: clamp(4rem, 9vw, 7rem); padding-bottom: 3rem; }
  .am-grad { background: var(--am-grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .am-eyebrow { display: inline-flex; align-items: center; gap: .55rem; margin: 0 0 .8rem; font: 600 .76rem var(--am-font-display); letter-spacing: .18em; text-transform: uppercase; color: var(--sl-color-accent-high); }
  .am-eyebrow::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--am-cyan); box-shadow: 0 0 10px var(--am-cyan); }
  .am-section h2, .am-cta h2 { margin: 0 0 2rem; max-width: 44rem; font: 700 clamp(1.9rem, 4vw, 2.9rem)/1.1 var(--am-font-display); letter-spacing: -.035em; color: var(--sl-color-white); text-wrap: balance; }
  .am-card, .am-level, .am-builds li, .am-stats {
    background: var(--am-card);
    border: 1px solid var(--sl-color-hairline-light);
    box-shadow: var(--am-glow);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* Stats */
  .am-stats { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; padding: 0; list-style: none; border-radius: 1.2rem; overflow: hidden; }
  .am-stats li { display: grid; gap: .2rem; padding: 1.5rem 1.6rem; border-inline-start: 1px solid var(--sl-color-hairline); }
  .am-stats li:first-child { border-inline-start: 0; }
  .am-stats strong { font: 700 clamp(1.8rem, 3.4vw, 2.4rem) var(--am-font-display); letter-spacing: -.03em; background: var(--am-grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .am-stats span { color: var(--sl-color-gray-3); font-size: .92rem; }

  /* Pillars */
  .am-pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .am-card { padding: 1.6rem; border-radius: 1.1rem; transition: transform .25s var(--am-ease), border-color .25s var(--am-ease); }
  .am-card:hover { transform: translateY(-4px); border-color: var(--sl-color-accent); }
  .am-icon { display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border-radius: .8rem; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); box-shadow: inset 0 0 0 1px var(--sl-color-hairline-light); }
  .am-icon svg { width: 1.35rem; height: 1.35rem; }
  .am-card h3, .am-level h3 { margin: 1.1rem 0 .45rem; font: 700 1.2rem var(--am-font-display); letter-spacing: -.02em; color: var(--sl-color-white); }
  .am-card p { margin: 0; color: var(--sl-color-gray-2); font-size: .95rem; line-height: 1.6; }

  /* Levels */
  .am-levels { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .am-levels::before { content: ''; position: absolute; top: 2.15rem; left: 2.6rem; right: 2.6rem; height: 2px; background: linear-gradient(90deg, #6366f1, #a855f7, #22d3ee); opacity: .7; }
  .am-level { position: relative; display: flex; flex-direction: column; height: 100%; padding: 1.4rem 1.6rem 1.6rem; border-radius: 1.2rem; color: inherit; text-decoration: none; transition: transform .25s var(--am-ease), border-color .25s var(--am-ease); }
  .am-level:hover { transform: translateY(-4px); border-color: var(--sl-color-accent); }
  .am-level:focus-visible { outline: 2px solid var(--sl-color-accent-high); outline-offset: 3px; }
  .am-level-node { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; margin-bottom: 1rem; border-radius: 50%; background: var(--am-grad); color: #fff; font: 700 .8rem var(--am-font-display); box-shadow: 0 0 0 5px var(--sl-color-black), 0 0 18px rgba(168, 85, 247, .7); }
  .am-level-tag { font: 600 .74rem var(--am-font-display); letter-spacing: .1em; text-transform: uppercase; color: var(--am-cyan); }
  .am-level ul { flex: 1; margin: .3rem 0 0; padding: 0; list-style: none; display: grid; gap: .45rem; color: var(--sl-color-gray-2); font-size: .94rem; }
  .am-level ul li::before { content: '→ '; color: var(--sl-color-accent-high); }
  .am-level-link { margin-top: 1.3rem; font-weight: 700; color: var(--sl-color-accent-high); }

  /* Builds */
  .am-builds { display: grid; grid-template-columns: repeat(2, 1fr); gap: .7rem; margin: 0; padding: 0; list-style: none; counter-reset: b; }
  .am-builds li { display: flex; align-items: center; gap: 1rem; padding: .95rem 1.2rem; border-radius: .9rem; color: var(--sl-color-gray-1); font-size: .98rem; }
  .am-builds li span { flex: none; font: 700 .85rem var(--am-font-display); color: var(--am-cyan); letter-spacing: .05em; }

  /* CTA */
  .am-cta { position: relative; overflow: hidden; display: grid; justify-items: center; text-align: center; padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem; border-radius: 1.6rem; border: 1px solid var(--sl-color-hairline-light); background: var(--am-card); }
  .am-cta-glow { position: absolute; inset: auto 10% -60% 10%; height: 120%; background: radial-gradient(closest-side, rgba(124, 108, 255, .45), rgba(34, 211, 238, .15), transparent); filter: blur(20px); pointer-events: none; }
  .am-cta h2 { position: relative; margin-bottom: .8rem; }
  .am-cta p { position: relative; margin: 0; max-width: 32rem; color: var(--sl-color-gray-2); font-size: 1.08rem; }
  .am-cta-actions { position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; margin-top: 1.8rem; }
  .am-btn { display: inline-flex; align-items: center; gap: .55rem; min-height: 3.1rem; padding: 0 1.5rem; border-radius: 999px; font-weight: 700; font-size: 1rem; text-decoration: none; transition: transform .2s var(--am-ease), box-shadow .2s var(--am-ease), border-color .2s var(--am-ease); }
  .am-btn-primary { background: var(--am-grad); color: #fff; box-shadow: 0 10px 34px rgba(91, 82, 240, .45); }
  .am-btn-primary:hover { transform: translateY(-2px); }
  .am-btn-ghost { color: var(--sl-color-white); border: 1px solid var(--sl-color-hairline-light); background: var(--am-card); }
  .am-btn-ghost:hover { border-color: var(--sl-color-accent); }
  .am-btn:focus-visible { outline: 2px solid var(--sl-color-accent-high); outline-offset: 3px; }

  @media (max-width: 62rem) {
    .am-pillars { grid-template-columns: repeat(2, 1fr); }
    .am-levels { grid-template-columns: 1fr; }
    .am-levels::before { top: 2.6rem; bottom: 2.6rem; left: 2.4rem; right: auto; width: 2px; height: auto; background: linear-gradient(180deg, #6366f1, #a855f7, #22d3ee); }
    .am-stats { grid-template-columns: repeat(2, 1fr); }
    .am-stats li:nth-child(3) { border-inline-start: 0; }
    .am-stats li:nth-child(n + 3) { border-top: 1px solid var(--sl-color-hairline); }
  }
  @media (max-width: 36rem) {
    .am-pillars, .am-builds { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .am-card:hover, .am-level:hover, .am-btn-primary:hover { transform: none; }
  }
</style>
