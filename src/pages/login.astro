---
const title = 'Acceso de alumnos | Academia Marketing + IA';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Accede a tu espacio de aprendizaje de Academia Marketing + IA." />
    <title>{title}</title>
    <link rel="stylesheet" href="/academy.css" />
  </head>
  <body>
    <main class="auth-shell">
      <a class="brand" href="/">Academia <span>Marketing + IA</span></a>
      <section class="panel auth-panel">
        <p class="eyebrow">TU ESPACIO DE APRENDIZAJE</p>
        <h1 id="form-title">Bienvenido de nuevo</h1>
        <p class="muted">Accede a tus cursos, recursos y progreso.</p>
        <div id="notice" class="notice" role="status" aria-live="polite"></div>
        <form id="auth-form">
          <label for="email">Correo electrónico</label>
          <input id="email" name="email" type="email" autocomplete="email" required placeholder="tu@correo.com" />
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" autocomplete="current-password" minlength="8" required placeholder="Mínimo 8 caracteres" />
          <button class="button primary" id="submit" type="submit">Iniciar sesión</button>
        </form>
        <p class="switch">¿Primera vez aquí? <button id="toggle" class="text-button" type="button">Crear cuenta</button></p>
        <a class="back-link" href="/">← Volver al programa público</a>
      </section>
    </main>
    <script>
      import { supabase } from '../lib/supabase';
      const form = document.querySelector('#auth-form');
      const notice = document.querySelector('#notice');
      const toggle = document.querySelector('#toggle');
      const title = document.querySelector('#form-title');
      const submit = document.querySelector('#submit');
      let registering = false;
      const show = (message, error = false) => {
        notice.textContent = message;
        notice.className = error ? 'notice error' : 'notice';
      };
      if (!supabase) show('Falta configurar PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY en Vercel.', true);
      toggle.addEventListener('click', () => {
        registering = !registering;
        title.textContent = registering ? 'Crea tu cuenta' : 'Bienvenido de nuevo';
        submit.textContent = registering ? 'Registrarme' : 'Iniciar sesión';
        toggle.textContent = registering ? 'Iniciar sesión' : 'Crear cuenta';
        show(registering ? 'Recibirás un correo para confirmar tu registro si la confirmación está activada.' : '');
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!supabase) return show('El acceso todavía no está configurado. Contacta al administrador.', true);
        const data = new FormData(form);
        const email = String(data.get('email'));
        const password = String(data.get('password'));
        submit.disabled = true;
        show('Procesando…');
        const result = registering
          ? await supabase.auth.signUp({ email, password, options: { emailRedirectTo: window.location.origin + '/dashboard' } })
          : await supabase.auth.signInWithPassword({ email, password });
        submit.disabled = false;
        if (result.error) return show(result.error.message, true);
        if (registering && !result.data.session) return show('Cuenta creada. Revisa tu correo para confirmar la dirección antes de iniciar sesión.');
        window.location.href = '/dashboard';
      });
    </script>
  </body>
</html>
